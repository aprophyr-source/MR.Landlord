<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MR.Landlord Dashboard</title>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#2563eb">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen text-gray-800 pb-12">

    <!-- Top Header Bar -->
    <header class="bg-blue-600 text-white shadow-md py-3 px-4 flex justify-between items-center sticky top-0 z-40">
        <h1 class="text-sm font-extrabold tracking-wide">🏠 MR.Landlord / <%= settings.landlord_name %></h1>
        <div class="flex items-center space-x-2">
            <a href="/app" class="bg-blue-700 hover:bg-blue-800 px-3 py-1.5 rounded text-xs font-bold">🏠 Home</a>
            <a href="/lock" class="bg-red-600 hover:bg-red-700 px-3 py-1.5 rounded text-xs font-bold">🔒 Lock</a>
        </div>
    </header>

    <div class="max-w-2xl mx-auto p-3 space-y-4">
        
        <% if (!activeTenant) { %>
            <!-- HOME VIEW: Big Room Cards & Add Button -->
            <div class="space-y-3 pt-2">
                <button onclick="toggleAddTenantModal()" class="w-full bg-green-600 hover:bg-green-700 text-white font-extrabold py-3.5 px-4 rounded-xl text-sm shadow-md flex items-center justify-center space-x-2">
                    <span class="text-lg">+</span>
                    <span>Add New Tenant / नया किराएदार जोड़ें</span>
                </button>

                <div class="flex justify-between items-center pt-2 px-1">
                    <h2 class="text-xs font-extrabold text-gray-500 uppercase tracking-wider">All Rooms & Tenants / सभी कमरे</h2>
                    <span class="text-xs text-gray-400"><%= tenants.length %> Total</span>
                </div>
                
                <!-- Big Room Cards List -->
                <div class="space-y-2.5">
                    <% if (tenants.length === 0) { %>
                        <div class="bg-white p-8 rounded-xl shadow border text-center text-gray-400 space-y-2">
                            <p class="text-base font-bold">No tenants added yet.</p>
                            <p class="text-xs">Click the green button above to add your first tenant!</p>
                        </div>
                    <% } %>
                    <% tenants.forEach(t => { %>
                        <a href="/tenant/<%= t.id %>" class="block bg-white p-4 rounded-xl shadow-sm border hover:border-blue-500 transition active:scale-[0.99]">
                            <div class="flex justify-between items-center">
                                <div>
                                    <span class="bg-blue-100 text-blue-800 text-[10px] font-extrabold px-2 py-0.5 rounded uppercase">Room <%= t.room %></span>
                                    <h3 class="text-base font-extrabold text-blue-900 mt-1"><%= t.name %></h3>
                                    <p class="text-xs text-gray-500 mt-0.5">Rent: ₹<%= t.monthly_rent %> | Phone: <%= t.phone || 'N/A' %></p>
                                </div>
                                <div class="text-right">
                                    <% if (t.due > 0) { %>
                                        <span class="bg-red-50 text-red-700 border border-red-200 px-2.5 py-1 rounded-lg text-xs font-extrabold block">Due: ₹<%= t.due %></span>
                                    <% } else if (t.advance > 0) { %>
                                        <span class="bg-green-50 text-green-700 border border-green-200 px-2.5 py-1 rounded-lg text-xs font-extrabold block">Adv: ₹<%= t.advance %></span>
                                    <% } else { %>
                                        <span class="bg-gray-50 text-gray-600 px-2.5 py-1 rounded-lg text-xs font-bold block">All Clear</span>
                                    <% } %>
                                </div>
                            </div>
                        </a>
                    <% }) %>
                </div>
            </div>

        <% } else { %>

            <!-- ACTIVE TENANT VIEW: Big UI Tabs & Actions -->
            <div class="space-y-3 pt-1">
                
                <!-- Explicit Back Button -->
                <a href="/app" class="inline-flex items-center space-x-1 bg-gray-200 hover:bg-gray-300 text-gray-800 px-3 py-1.5 rounded-lg text-xs font-extrabold shadow-sm">
                    <span>⬅️ Back to Room List / पीछे जाएं</span>
                </a>

                <!-- Tenant Info Card -->
                <div class="bg-white p-4 rounded-xl shadow-sm border relative">
                    <form action="/tenant/delete/<%= activeTenant.id %>" method="POST" onsubmit="return confirm('Delete tenant and history?');" class="absolute top-4 right-4">
                        <button type="submit" class="bg-red-100 text-red-700 hover:bg-red-600 hover:text-white px-2.5 py-1 rounded-lg text-xs font-bold transition">Delete</button>
                    </form>

                    <span class="bg-blue-100 text-blue-800 text-xs font-extrabold px-2.5 py-0.5 rounded">Room <%= activeTenant.room %></span>
                    <h2 class="text-xl font-extrabold text-blue-900 mt-1"><%= activeTenant.name %></h2>
                    <p class="text-xs text-gray-500 mt-0.5">Phone: <%= activeTenant.phone || 'N/A' %> • Monthly Rent: ₹<%= activeTenant.monthly_rent %></p>

                    <!-- Balance Summary Boxes -->
                    <div class="grid grid-cols-2 gap-3 mt-4">
                        <div class="bg-red-50 border border-red-200 p-3 rounded-xl text-center">
                            <span class="text-[11px] font-extrabold text-red-700 block uppercase">Total Due / बकाया</span>
                            <span class="text-xl font-black text-red-600">₹<%= activeTenant.due %></span>
                        </div>
                        <div class="bg-green-50 border border-green-200 p-3 rounded-xl text-center">
                            <span class="text-[11px] font-extrabold text-green-700 block uppercase">Advance / एडवांस</span>
                            <span class="text-xl font-black text-green-600">₹<%= activeTenant.advance %></span>
                        </div>
                    </div>

                    <!-- Quick QR Code Payment Button -->
                    <% if (activeTenant.phone) { %>
                        <div class="mt-3">
                            <button onclick="toggleQRModal()" class="w-full bg-purple-50 hover:bg-purple-100 text-purple-700 border border-purple-200 font-bold py-2 px-3 rounded-xl text-xs flex items-center justify-center space-x-2">
                                <span>📱 Show UPI QR Code for Payment / क्यूआर कोड दिखाएं</span>
                            </button>
                        </div>
                    <% } %>
                </div>

                <!-- BIG ACTION TABS: Switch between Recording Transaction & Viewing Records -->
                <div class="grid grid-cols-2 gap-2 bg-gray-200 p-1 rounded-xl">
                    <button id="tabTxBtn" onclick="switchTab('tx')" class="py-2.5 rounded-lg text-xs font-extrabold bg-white text-blue-900 shadow-sm transition">
                        ➕ Record Transaction
                    </button>
                    <button id="tabHistoryBtn" onclick="switchTab('history')" class="py-2.5 rounded-lg text-xs font-extrabold text-gray-600 hover:text-gray-900 transition">
                        📜 View Records (<%= history.length %>)
                    </button>
                </div>

                <!-- TAB 1: RECORD TRANSACTION FORM (Protected against double click) -->
                <div id="tabTxContent" class="bg-white p-4 rounded-xl shadow-sm border">
                    <h3 class="text-xs font-extrabold text-gray-700 uppercase mb-3 pb-1 border-b">New Payment / Charge Entry</h3>
                    
                    <form action="/tenant/<%= activeTenant.id %>/transaction" method="POST" class="space-y-3" onsubmit="handleFormSubmit(this)">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Amount (₹) / राशि</label>
                            <input type="number" name="amount" required placeholder="e.g. 2000" class="w-full px-3 py-2 border rounded-xl text-sm font-bold bg-gray-50 focus:bg-white">
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Type / प्रकार</label>
                            <select name="type" class="w-full px-3 py-2 border rounded-xl text-xs bg-white font-bold text-blue-900">
                                <option value="payment">Payment Received (Due Clear / Advance)</option>
                                <option value="charge">Add Rent / Extra Charge (+ Due)</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Collected By / किसने लिया</label>
                            <select name="collector" class="w-full px-3 py-2 border rounded-xl text-xs bg-white font-bold text-blue-900">
                                <option value="Amal">Amal / अमल</option>
                                <option value="Krishna">Krishna / कृष्णा</option>
                                <option value="Abhishek">Abhishek / अभिषेक</option>
                                <option value="Abhijeet">Abhijeet / अभिजीत</option>
                            </select>
                        </div>

                        <!-- Backdated Date Dropdowns -->
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Transaction Date / लेनदेन की तिथि (Backdated OK)</label>
                            <div class="grid grid-cols-3 gap-2">
                                <select name="tx_date" class="px-2 py-2 border rounded-xl text-xs bg-white font-bold">
                                    <% for(let d=1; d<=31; d++) { %>
                                        <option value="<%= d %>" <%= d === new Date().getDate() ? 'selected' : '' %>><%= d %></option>
                                    <% } %>
                                </select>
                                <select name="tx_month" class="px-2 py-2 border rounded-xl text-xs bg-white font-bold">
                                    <% const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]; %>
                                    <% const curMonthIdx = new Date().getMonth(); %>
                                    <% months.forEach((m, idx) => { %>
                                        <option value="<%= m %>" <%= idx === curMonthIdx ? 'selected' : '' %>><%= m %></option>
                                    <% }) %>
                                </select>
                                <select name="tx_year" class="px-2 py-2 border rounded-xl text-xs bg-white font-bold">
                                    <% const curYear = new Date().getFullYear(); %>
                                    <% for(let y=2020; y<=2100; y++) { %>
                                        <option value="<%= y %>" <%= y === curYear ? 'selected' : '' %>><%= y %></option>
                                    <% } %>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Note / विवरण (Optional)</label>
                            <input type="text" name="note" placeholder="e.g. October Rent / Current Bill" class="w-full px-3 py-2 border rounded-xl text-xs bg-gray-50 focus:bg-white">
                        </div>

                        <button type="submit" id="submitBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-extrabold py-3 rounded-xl text-sm shadow-md transition">
                            Submit & Generate Invoice 🚀
                        </button>
                    </form>
                </div>

                <!-- TAB 2: TRANSACTION HISTORY / RECORDS -->
                <div id="tabHistoryContent" class="bg-white p-4 rounded-xl shadow-sm border hidden space-y-2.5">
                    <h3 class="text-xs font-extrabold text-gray-700 uppercase pb-1 border-b">Payment Records & History</h3>
                    <div class="space-y-2 max-h-[400px] overflow-y-auto">
                        <% if (history.length === 0) { %>
                            <p class="text-xs text-gray-400 text-center py-6">No transaction history recorded yet.</p>
                        <% } %>
                        <% history.forEach(h => { %>
                            <div class="p-3 rounded-xl border text-xs flex justify-between items-center <%= h.type === 'payment' ? 'bg-green-50 border-green-200' : 'bg-red-50 border-red-200' %>">
                                <div>
                                    <span class="font-extrabold block text-gray-900"><%= h.date %> — <%= h.note || (h.type === 'payment' ? 'Payment' : 'Charge') %></span>
                                    <span class="text-gray-500 text-[10px]">Collector: <%= h.collector %></span>
                                </div>
                                <span class="font-black text-sm <%= h.type === 'payment' ? 'text-green-700' : 'text-red-700' %>">
                                    <%= h.type === 'payment' ? '-' : '+' %>₹<%= h.amount %>
                                </span>
                            </div>
                        <% }) %>
                    </div>
                </div>

            </div>
        <% } %>

    </div>

    <!-- Modal for Adding Tenant -->
    <div id="addTenantModal" class="fixed inset-0 bg-black bg-opacity-60 hidden flex items-center justify-center p-3 z-50">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-5 relative border">
            <div class="flex justify-between items-center mb-4 border-b pb-2">
                <h3 class="text-sm font-extrabold text-blue-900 uppercase">Add New Tenant / नया किराएदार</h3>
                <button onclick="toggleAddTenantModal()" class="text-gray-400 hover:text-gray-700 font-bold text-xl">&times;</button>
            </div>
            
            <form action="/tenant/add" method="POST" class="space-y-3" onsubmit="handleFormSubmit(this)">
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Tenant Name / नाम</label>
                    <input type="text" name="name" required placeholder="e.g. Santosh Verma" class="w-full px-3 py-2 border rounded-xl text-xs">
                </div>
                
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Room No / कमरा नंबर</label>
                        <input type="text" name="room" required placeholder="e.g. Room 1" class="w-full px-3 py-2 border rounded-xl text-xs">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Phone / फोन नंबर</label>
                        <input type="text" name="phone" placeholder="e.g. 9876543210" class="w-full px-3 py-2 border rounded-xl text-xs">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Monthly Rent (₹) / किराया</label>
                        <input type="number" name="monthly_rent" required placeholder="e.g. 3000" class="w-full px-3 py-2 border rounded-xl text-xs">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Initial Due (₹) / बकाया</label>
                        <input type="number" name="initial_due" placeholder="e.g. 0" class="w-full px-3 py-2 border rounded-xl text-xs">
                    </div>
                </div>

                <div class="flex space-x-2 pt-2">
                    <button type="button" onclick="toggleAddTenantModal()" class="w-1/2 bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold py-2.5 rounded-xl text-xs">
                        Cancel
                    </button>
                    <button type="submit" class="w-1/2 bg-green-600 hover:bg-green-700 text-white font-extrabold py-2.5 rounded-xl text-xs shadow">
                        Save Tenant
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal for UPI QR Code -->
    <% if (activeTenant) { %>
    <div id="qrModal" class="fixed inset-0 bg-black bg-opacity-60 hidden flex items-center justify-center p-3 z-50">
        <div class="bg-white rounded-2xl shadow-2xl max-w-xs w-full p-5 text-center relative border space-y-3">
            <div class="flex justify-between items-center border-b pb-2">
                <h3 class="text-xs font-extrabold text-purple-900 uppercase">Scan to Pay via UPI</h3>
                <button onclick="toggleQRModal()" class="text-gray-400 hover:text-gray-700 font-bold text-xl">&times;</button>
            </div>
            <p class="text-xs font-bold text-gray-800"><%= activeTenant.name %> (Room <%= activeTenant.room %>)</p>
            
            <!-- Dynamic UPI QR generated via free public API -->
            <div class="bg-gray-50 p-3 rounded-xl border inline-block">
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=upi://pay?pa=landlord@upi&pn=<%= encodeURIComponent(settings.landlord_name) %>&am=<%= activeTenant.monthly_rent %>&cu=INR" alt="UPI QR Code" class="mx-auto rounded">
            </div>

            <p class="text-[10px] text-gray-500">Scan with Google Pay, PhonePe, or Paytm to pay monthly rent of ₹<%= activeTenant.monthly_rent %>.</p>
            <button onclick="toggleQRModal()" class="w-full bg-purple-600 text-white font-extrabold py-2 rounded-xl text-xs shadow">Close</button>
        </div>
    </div>
    <% } %>

    <script>
        function toggleAddTenantModal() {
            document.getElementById('addTenantModal').classList.toggle('hidden');
        }

        function toggleQRModal() {
            const modal = document.getElementById('qrModal');
            if(modal) modal.classList.toggle('hidden');
        }

        // Tab Switcher for Big UI Layout
        function switchTab(tab) {
            const txContent = document.getElementById('tabTxContent');
            const historyContent = document.getElementById('tabHistoryContent');
            const txBtn = document.getElementById('tabTxBtn');
            const historyBtn = document.getElementById('tabHistoryBtn');

            if (tab === 'tx') {
                txContent.classList.remove('hidden');
                historyContent.classList.add('hidden');
                txBtn.className = "py-2.5 rounded-lg text-xs font-extrabold bg-white text-blue-900 shadow-sm transition";
                historyBtn.className = "py-2.5 rounded-lg text-xs font-extrabold text-gray-600 hover:text-gray-900 transition";
            } else {
                txContent.classList.add('hidden');
                historyContent.classList.remove('hidden');
                historyBtn.className = "py-2.5 rounded-lg text-xs font-extrabold bg-white text-blue-900 shadow-sm transition";
                txBtn.className = "py-2.5 rounded-lg text-xs font-extrabold text-gray-600 hover:text-gray-900 transition";
            }
        }

        // Double-Click Protection: Disables button and shows Processing on submit
        function handleFormSubmit(form) {
            const btn = form.querySelector('button[type="submit"]');
            if (btn) {
                btn.disabled = true;
                btn.style.opacity = '0.7';
                btn.innerHTML = '⏳ Processing... Please Wait';
            }
        }

        // PWA Service Worker Registration
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js');
        }
    </script>
</body>
</html>
