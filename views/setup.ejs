<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><title>Setup</title><script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script></head>
<body class="bg-blue-50 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-6 rounded-2xl shadow-xl w-full max-w-sm">
        <h1 class="text-xl font-bold text-blue-900 mb-1">Rental App Setup</h1>
        <p class="text-xs text-gray-500 mb-4">पहला सेटअप - अपना पासवर्ड और नाम सेट करें</p>
        <form action="/setup" method="POST" class="space-y-4">
            <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1">Landlord Name / मकान मालिक का नाम</label>
                <input type="text" name="landlord_name" placeholder="e.g. Pulin Chandra Majhi" required class="w-full px-3 py-2 border rounded-lg text-sm">
            </div>
            <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1">Secret Passcode / गुप्त पासवर्ड</label>
                <input type="password" name="passcode" placeholder="Enter secure passcode" required class="w-full px-3 py-2 border rounded-lg text-sm">
            </div>
            <button type="submit" class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg text-sm shadow">Save & Start App</button>
        </form>
    </div>
</body>
</html>
